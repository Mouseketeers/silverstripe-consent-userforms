    "authors": [
        {
            "name": "Henrik Olsen",
            "email": "henrik@mouseketeers.dk"
        }
    ],
    "support": {
        "issues": "https://github.com/Mouseketeers/silverstripe-consent-forms-userforms/issues",
        "source": "https://github.com/Mouseketeers/silverstripe-consent-forms-userforms"
    },
    "require": {
        "silverstripe/framework": "^4.0",
        "silverstripe/userforms": "^5.0",
        "mouseketeers/silverstripe-consent-forms": "^3.0"
